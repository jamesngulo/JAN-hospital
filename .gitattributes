    <script>
    // Function to handle the slideshow
    function startSlideshow(slideshowId) {
        const slideshow = document.getElementById(slideshowId);
        if (!slideshow) return; // Prevent error if element not found
        const images = slideshow.querySelectorAll("img");
        if (images.length === 0) return; // No images to show

        let currentIndex = 0;

        setInterval(() => {
            images[currentIndex].classList.remove("active");
            currentIndex = (currentIndex + 1) % images.length;
            images[currentIndex].classList.add("active");
        }, 3000); // Change image every 3 seconds
    }

    // Wait for DOM to be fully loaded before starting slideshows
    document.addEventListener("DOMContentLoaded", function () {
        startSlideshow("general-medicine-slideshow");
        startSlideshow("surgery-slideshow");
        // Add more calls for other services if needed
    });
